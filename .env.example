# Database configuration — replace with real credentials (never commit .env)
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/industrial_erp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Docker Compose (local development database)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=industrial_erp

# Application
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
# SECRET_KEY must be a random value of at least 32 bytes in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set to "true" when the app runs behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=60

# Simulation defaults
SIM_FAILURE_RATE=0.03
SIM_YIELD_MEAN=0.96
SIM_INSPECTION_FAILURE_RATE=0.04
SIM_DOWNTIME_PROBABILITY=0.05
