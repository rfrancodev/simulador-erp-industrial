# ── PostgreSQL (external, production) ──────────────────────────────────
# The production API connects to the externally-managed PostgreSQL on the
# VPS host (container `industrial-erp-postgres`), published on the host
# loopback at 127.0.0.1:5432. Replace <password> with the real value in the
# local `.env` file — never commit it and never put it in versioned files.
DATABASE_URL=postgresql://industrial_app:<password>@127.0.0.1:5432/industrial_erp

# Connection pool tuning (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600

# ── Local development database (docker-compose.yml only) ───────────────
# Used only by the local `db` service. Production uses the external
# PostgreSQL above, not these values.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=industrial_erp

# ── Application ─────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Security ───────────────────────────────────────────────────────────
# SECRET_KEY must be a random value of at least 32 bytes in production.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set to "true" only when requests arrive from configured trusted proxy IPs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
RATE_LIMIT_PER_MINUTE=60
# Set to "true" in production (behind Cloudflare/HTTPS) so the dashboard auth
# cookie is only sent over HTTPS. The reverse proxy terminates TLS, so the app
# itself sees HTTP — this flag restores the Secure attribute on the cookie.
COOKIE_SECURE=false

# CORS is intentionally not configured (dashboard is server-side rendered and
# served on the same origin via the reverse proxy). If an external SPA is added,
# introduce a restricted allowlist here and wire CORSMiddleware.
# CORS_ORIGINS=

# ── Simulation defaults ────────────────────────────────────────────────
SIM_FAILURE_RATE=0.03
SIM_YIELD_MEAN=0.96
SIM_INSPECTION_FAILURE_RATE=0.04
SIM_DOWNTIME_PROBABILITY=0.05