# Reverse proxy template for the Industrial ERP Simulator API (production).
#
# 1. Copy to nginx.conf and replace <DOMAIN> with the public domain
#    (suggested: erp.francorafael.com).
# 2. This listens on HTTP (port 80). TLS is terminated upstream by Cloudflare
#    (DNS + SSL proxy) or Nginx Proxy Manager — the app sees HTTP from the proxy.
# 3. The FastAPI container runs with `network_mode: host` and binds to
#    `127.0.0.1:8000` on the VPS loopback, so nginx proxies to 127.0.0.1:8000.

server {
    listen 80;
    server_name <DOMAIN>;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, rather than append, so clients cannot spoof the value.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
